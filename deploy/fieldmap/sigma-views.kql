// Kusto canonical-field views, generated by pipeline/build_field_map.py.
//
// The rules read Sigma names; these functions expose each log table under
// those names without changing the workspace schema. Attach them to the
// queries, not to the tables: a stored function is the only shape that does
// not require a schema migration.
//
// Not executed against a live workspace.

let Sigma_SecurityEvent = SecurityEvent | project EventID = EventID, Computer = Computer, ObjectName = ObjectName, AccessMask = AccessMask;
let Sigma_DeviceProcessEvents = DeviceProcessEvents | project Image = FolderPath, CommandLine = ProcessCommandLine, ParentImage = InitiatingProcessFolderPath, ProcessId = ProcessId, ProcessGuid = ProcessId;
let Sigma_Sysmon = Sysmon | project Image = FolderPath, CommandLine = ProcessCommandLine, ParentImage = InitiatingProcessFolderPath, TargetFilename = FileName, TargetObject = RegistryKey, ProcessGuid = ProcessId, ParentProcessGuid = InitiatingProcessId;

// Fields with no clean Kusto equivalent are listed in
// telemetry/field-map.json under `note`; read them before
// assuming a rule behaves the same on Sentinel as on Splunk.
