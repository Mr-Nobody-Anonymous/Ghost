// generated by deploy/build_joins.py from sigma/windows/defense-evasion/patch_sequence.yml
// pySigma does not convert correlations for Kusto; this is the join.
let window = 5m;
let step1 = SecurityEvent | where (EventID == "4663" and isnotempty(Computer) and (ObjectName contains "HARDWARE\DESCRIPTION\System\CentralProcessor\0") and AccessMask matches regex "^0x1$") | extend _ord = 1 | project TimeGenerated, Computer, _ord;
let step2 = SecurityEvent | where ((((EventID == "1" and isnotempty(Computer) and (FolderPath endswith "\sc.exe" or FolderPath endswith "\net.exe" or FolderPath endswith "\net1.exe") and (ProcessCommandLine contains "stop windefend" or ProcessCommandLine contains "stop sense" or ProcessCommandLine contains "stop csagent" or ProcessCommandLine contains "stop mbamservice")) or ((EventID == "12" or EventID == "13" or EventID == "14") and (RegistryKey contains "\SOFTWARE\Microsoft\AMSI\Providers\"))) or ((EventID == "12" or EventID == "13" or EventID == "14") and (RegistryKey endswith "\Windows Defender\DisableAntiSpyware" or RegistryKey endswith "\Windows Defender\DisableAntiVirus" or RegistryKey endswith "\Windows Defender\Real-Time Protection\DisableRealtimeMonitoring") and Details == "DWORD (0x00000001)")) or (EventID == "1" and (FolderPath endswith "\powershell.exe" or FolderPath endswith "\pwsh.exe") and (ProcessCommandLine contains "Set-MpPreference -Disable" or ProcessCommandLine contains "Add-MpPreference -Disable" or ProcessCommandLine contains "Set-MpPreference -ExclusionPath"))) | extend _ord = 2 | project TimeGenerated, Computer, _ord;
union step1, step2
| sort by TimeGenerated asc
| summarize span = max(TimeGenerated) - min(TimeGenerated), steps = make_list(_ord) by Computer
| where span <= window and array_length(steps) == 2
| where steps == range(1, 2)
| where span <= 5m
