// generated by deploy/build_joins.py from sigma/windows/persistence/wmi_subscription_triple.yml
// pySigma converts correlations only for Splunk; this is the EQL equivalent
sequence by host.name with maxspan=30s
  [any where (event.code == "19" and host.name != null)]
  [any where (event.code == "20" and host.name != null and (Type : "*CommandLineEventConsumer*"))]
  [any where (event.code == "21" and host.name != null)]
