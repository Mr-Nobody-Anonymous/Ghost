// generated by deploy/build_joins.py from sigma/windows/persistence/wmi_subscription_triple.yml
// pySigma does not convert correlations for Kusto; this is the join.
let window = 30s;
let step1 = SecurityEvent | where (EventID == "19" and isnotempty(Computer)) | extend _ord = 1 | project TimeGenerated, Computer, _ord;
let step2 = SecurityEvent | where (EventID == "20" and isnotempty(Computer) and (Type contains "CommandLineEventConsumer")) | extend _ord = 2 | project TimeGenerated, Computer, _ord;
let step3 = SecurityEvent | where (EventID == "21" and isnotempty(Computer)) | extend _ord = 3 | project TimeGenerated, Computer, _ord;
union step1, step2, step3
| sort by TimeGenerated asc
| summarize span = max(TimeGenerated) - min(TimeGenerated), steps = make_list(_ord) by Computer
| where span <= window and array_length(steps) == 3
| where steps == range(1, 3)
| where span <= 30s
