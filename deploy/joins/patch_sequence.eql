// generated by deploy/build_joins.py from sigma/windows/defense-evasion/patch_sequence.yml
// pySigma converts correlations only for Splunk; this is the EQL equivalent
sequence by host.name with maxspan=5m
  [any where (event.code == "4663" and host.name != null and (registry.path : "*HARDWARE\\DESCRIPTION\\System\\CentralProcessor\\0*") and AccessMask == "0x1")]
  [any where ((((event.code == "1" and host.name != null and (process.executable : "*sc.exe" or process.executable : "*net.exe" or process.executable : "*net1.exe") and (process.command_line : "*stop windefend*" or process.command_line : "*stop sense*" or process.command_line : "*stop csagent*" or process.command_line : "*stop mbamservice*")) or ((event.code == "12" or event.code == "13" or event.code == "14") and (registry.path : "*\\SOFTWARE\\Microsoft\\AMSI\\Providers\\*"))) or ((event.code == "12" or event.code == "13" or event.code == "14") and (registry.path : "*Windows Defender\\DisableAntiSpyware" or registry.path : "*Windows Defender\\DisableAntiVirus" or registry.path : "*Windows Defender\\Real-Time Protection\\DisableRealtimeMonitoring") and Details == "DWORD (0x00000001)")) or (event.code == "1" and (process.executable : "*powershell.exe" or process.executable : "*pwsh.exe") and (process.command_line : "*Set-MpPreference -Disable*" or process.command_line : "*Add-MpPreference -Disable*" or process.command_line : "*Set-MpPreference -ExclusionPath*")))]
