// generated by deploy/build_joins.py from sigma/windows/process/dns_query_burst_host.yml
// pySigma does not convert correlations for Kusto.
SecurityEvent
| where ((EventID == "22" and isnotempty(ProcessGuid) and Name matches regex "^[a-z]{13,}\.(com|net|org|info|biz|ru|top|xyz)$") and not (((FolderPath endswith "\svchost.exe" or FolderPath endswith "\OneDrive.exe"))))
| summarize events = count() by ProcessGuid, bin(TimeGenerated, 5m)
| where events >= 20
