// generated by deploy/build_joins.py from sigma/beaconing_frequency.yml
// pySigma does not convert correlations for Elastic. A threshold is an
// aggregation, not a sequence, so this is ES|QL.
FROM logs-*
| WHERE ((cs-header-X-Id IS NOT NULL AND cs-header-X-Seq IS NOT NULL AND source.ip IS NOT NULL AND destination.domain IS NOT NULL) or ((((url.path LIKE "*/poll") AND source.ip IS NOT NULL AND destination.domain IS NOT NULL) and (url.query LIKE "*id=*" and url.query LIKE "*seq=*")) and ((user_agent.original LIKE "Mozilla/5.0*"))))
| STATS events = COUNT(*) BY source.ip, destination.domain, bucket = BUCKET(@timestamp, 10 m)
| WHERE events >= 20
