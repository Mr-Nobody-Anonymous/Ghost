// generated by deploy/build_joins.py from sigma/beaconing_frequency.yml
// pySigma does not convert correlations for Kusto.
CommonSecurityLog
| where ((isnotempty(cs-header-X-Id) and isnotempty(cs-header-X-Seq) and isnotempty(SrcIpAddr) and isnotempty(DstHostname)) or ((((cs-uri-stem endswith "/poll") and isnotempty(SrcIpAddr) and isnotempty(DstHostname)) and (cs-uri-query contains "id=" and cs-uri-query contains "seq=")) and ((cs-user-agent startswith "Mozilla/5.0"))))
| summarize events = count() by SrcIpAddr, bin(TimeGenerated, 10m)
| where events >= 20
