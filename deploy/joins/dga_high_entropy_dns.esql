// generated by deploy/build_joins.py from sigma/dga_high_entropy_dns.yml
// pySigma does not convert correlations for Elastic. A threshold is an
// aggregation, not a sequence, so this is ES|QL.
FROM logs-*
| WHERE (rcode == "NXDOMAIN" AND source.ip IS NOT NULL AND dns.question.name RLIKE "^[a-z]{14,}\\.(com|net|org|info|biz|ru|top|xyz)$")
| STATS events = COUNT(*) BY source, bucket = BUCKET(@timestamp, 5 m)
| WHERE events >= 20
