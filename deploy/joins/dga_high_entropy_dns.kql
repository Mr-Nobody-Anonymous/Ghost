// generated by deploy/build_joins.py from sigma/dga_high_entropy_dns.yml
// pySigma does not convert correlations for Kusto.
SecurityEvent
| where (rcode == "NXDOMAIN" and isnotempty(SrcIpAddr) and Name matches regex "^[a-z]{14,}\.(com|net|org|info|biz|ru|top|xyz)$")
| summarize events = count() by Source, bin(TimeGenerated, 5m)
| where events >= 20
