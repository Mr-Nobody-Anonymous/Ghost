// generated by deploy/build_joins.py from sigma/windows/process/dns_query_burst_host.yml
// pySigma does not convert correlations for Elastic. A threshold is an
// aggregation, not a sequence, so this is ES|QL.
FROM logs-*
| WHERE ((event.code == "22" AND ProcessGuid IS NOT NULL AND dns.question.name RLIKE "^[a-z]{13,}\\.(com|net|org|info|biz|ru|top|xyz)$") and NOT (((process.executable LIKE "*\\svchost.exe" or process.executable LIKE "*\\OneDrive.exe"))))
| STATS events = COUNT(*) BY process.entity_id, bucket = BUCKET(@timestamp, 5 m)
| WHERE events >= 20
