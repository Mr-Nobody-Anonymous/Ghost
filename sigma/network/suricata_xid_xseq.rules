# Suricata rules for the custom-header C2 pattern.
# Detection signatures only. No implant code.
alert http any any -> any any (msg:"C2 beacon - X-Id and X-Seq header pair"; flow:established,to_server; http.header; content:"X-Id|3a 20|"; nocase; http.header; content:"X-Seq|3a 20|"; nocase; threshold:type limit,track by_src,count 1,seconds 300; classtype:trojan-activity; sid:9001001; rev:1; metadata:attack T1071.001;)

alert http any any -> any any (msg:"C2 poll - /poll?id=&seq= with browser UA"; flow:established,to_server; http.uri; content:"/poll"; startswith; http.uri; content:"id="; http.uri; content:"seq="; http.user_agent; content:"Mozilla/5.0"; threshold:type limit,track by_src,count 3,seconds 600; classtype:trojan-activity; sid:9001002; rev:1; metadata:attack T1071.001;)

alert http any any -> any any (msg:"C2 result POST - octet-stream body with X-Id"; flow:established,to_server; http.method; content:"POST"; http.header; content:"X-Id|3a 20|"; nocase; http.header; content:"Content-Type|3a 20|application/octet-stream"; nocase; threshold:type limit,track by_src,count 1,seconds 300; classtype:trojan-activity; sid:9001003; rev:1; metadata:attack T1041;)
