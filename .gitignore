# Python bytecode
__pycache__/
*.py[cod]
*.egg-info/

# Generated packages and local artifacts
dist/
build/
*.tgz
*.tar.gz

# Local emulator output
emulator_traffic.log
canary_*.txt

# Virtual environments
.venv/
venv/
env/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Secrets - never commit real credentials or keys
*.pem
*.key
*.pfx
*.env
.env.*

# The YARA corpus is generated, never committed: this repository's defensive-only
# claim includes "no binary artifacts in git" (tests/test_scope.py). The files
# are deterministic, so the gate rebuilds them; yara/corpus/README.md explains
# each one and is committed.
yara/corpus/benign/
yara/corpus/implant/
yara/corpus/partial/

# Large pinned bundles are cached locally, never committed
attack/cache/
fixtures/captured/

# Local resolution scratch (kept for humans, regenerated by tools/update_pins.py)
samples/PINS.local.md
