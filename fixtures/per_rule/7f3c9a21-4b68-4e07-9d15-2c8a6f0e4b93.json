  "members": {
    "1a2b3c4d-5e6f-4708-9a0b-1c2d3e4f5a05": {
      "title": "CPU Information Enumeration Followed by Security Tool Tampering",
      "id": "1a2b3c4d-5e6f-4708-9a0b-1c2d3e4f5a05",
      "dedup_key": "rule:1a2b3c4d-5e6f-4708-9a0b-1c2d3e4f5a05:host:user",
      "status": "experimental",
      "lifecycle": "designed",
      "description": "Correlation of a CPU-identifier read with a follow-on attempt to weaken a security component shortly afterwards from the same user context: a service or driver stopped, an AMSI provider removed, a Defender preference altered, or a signed security service touched. The original draft chained a Security 4663 registry read to a Sysmon 10 process access; that pairing cannot fire, because 4663 carries no ProcessId shared with Sysmon and Sysmon 10 reports a process image rather than a loaded module. Both members carry Computer, so that is the join key. This version keeps only events that a default Windows audit policy can actually produce.\n",
      "author": "ghost-detection-lab",
      "date": "2026-11-27",
      "sample_ref": "PIN-0000",
      "sigma_spec_version": "2.1.0",
      "dedup_window": "5m",
