#!/usr/bin/env bash
# Fast pre-commit check. The full gate is slow enough that people stop running
# it before a commit, which is exactly how a repository ends up with green CI
# and a broken tree. This runs the cheap, deterministic subset: format-free
# correctness lint, the tests, and the fixture freshness check. Everything that
# needs the network, the converter, or a full rule sweep stays in ci/gate.sh.
#
# Install once per clone:
#     git config core.hooksPath .githooks
#
# Bypass for a deliberate work-in-progress commit:
#     git commit --no-verify
#
# CI runs the full gate regardless, so bypassing here cannot get anything merged.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

# Only files that are staged and actually affect the checks. A commit touching
# only Markdown should not pay for the rule suite.
staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if [ -z "$staged" ]; then
  exit 0
fi

needs_python=0
while IFS= read -r f; do
  case "$f" in
    *.py) needs_python=1 ;;
    sigma/*.yml|fixtures/*|*.json|*.yar|*.sh) needs_python=1 ;;
  esac
done <<< "$staged"

if [ "$needs_python" -eq 0 ]; then
  echo "pre-commit: no code or rule files staged, skipping"
  exit 0
fi

# Pick an interpreter that actually has the pinned dependencies. Falling back to
# a bare `python3` that lacks ruff would fail the commit with a message about a
# missing module, which reads like a broken repository rather than a missing
# environment - and teaches people to use --no-verify.
python_bin=""
for candidate in ".venv/bin/python" "$(command -v python3)" \
                 "/tmp/venv/bin/python"; do
  if [ -n "$candidate" ] && [ -x "$candidate" ] && \
     "$candidate" -c 'import ruff' 2>/dev/null; then
    python_bin="$candidate"
    break
  fi
done
if [ -z "$python_bin" ]; then
  if [ -n "${VIRTUAL_ENV:-}" ] || [ -x ".venv/bin/python" ]; then
    echo "pre-commit: no interpreter with ruff found; install -r requirements.txt" >&2
    exit 1
  fi
  echo "pre-commit: no interpreter with ruff found; skipping the fast checks." >&2
  echo "             CI runs the full gate. Install with: pip install -r requirements.txt" >&2
  exit 0
fi

echo "pre-commit: [1/3] correctness lint"
"$python_bin" -m ruff check . --quiet

echo "pre-commit: [2/3] tests"
"$python_bin" -m unittest discover -s tests -p 'test_*.py' 2>&1 | tail -3

echo "pre-commit: [3/3] fixtures match their rules"
"$python_bin" tools/generate_fixtures.py --check

echo "pre-commit: OK (full gate: bash ci/gate.sh)"
